# ============================================
# .env.example — скопируй в .env и заполни
#   cp .env.example .env
# .env НИКОГДА не коммитится (см. .gitignore).
# ============================================
#
# Откуда берутся переменные:
#   • Личные / шаблонные проекты: локальный .env (этот файл) + глобальный
#     кошелёк ~/claude/.env. Локальный имеет приоритет.
#   • КОММЕРЧЕСКИЕ проекты (projects/commercial/): ТОЛЬКО локальный .env.
#     Глобальный кошелёк намеренно игнорируется — клиентские данные изолированы.
#     => для commercial укажи здесь ВСЕ ключи, ничего не наследуется.
#
# Загрузка в коде: env_loader.load_project_env(Path(__file__).resolve().parent)
# ============================================

# --- Project-specific секреты (всегда локально) ---
SERVICE_API_KEY=
DATABASE_URL=

# --- Общие ключи ---
# Для НЕ-коммерческих проектов можно НЕ дублировать — придут из ~/claude/.env.
# Для КОММЕРЧЕСКИХ — обязательно заполни здесь.
# OPENROUTER_API_KEY=
# GOOGLE_GEMINI_API_KEY=
# PERPLEXITY_API_KEY=
